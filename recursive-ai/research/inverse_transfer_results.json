  "reproduced_sources": {
    "donor": {
      "source": "def lower_bound(values, target):\n    low = 0\n    high = len(values)\n    while low < high:\n        mid = (low + high) // 2\n        if values[mid] < target:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n",
      "sha256": "e6d47ad651666e7f818c4ecfd65b1ecf7b3404725c36a304eed3367b61bc513d"
    },
    "integer_sqrt": {
      "source": "def integer_sqrt(n):\n    low = 0\n    high = n + 1\n    while low < high:\n        mid = (low + high) // 2\n        if mid * mid <= n:\n            low = mid + 1\n        else:\n            high = mid\n    return low - 1\n",
      "sha256": "9cadb7fb06b0d867d0530e164e849594d810b354f51cbaed572a9b12cceee15c"
    },
    "triangular_inverse": {
      "source": "def triangular_inverse(n):\n    low = 0\n    high = n + 1\n    while low < high:\n        mid = (low + high) // 2\n        if mid * (mid + 1) // 2 <= n:\n            low = mid + 1\n        else:\n            high = mid\n    return low - 1\n",
      "sha256": "5962fcc55302a3e5b3cf390ea3b781aa81afbebe5fd8e31d6247ea8a6f0d189e"
    }
  },
