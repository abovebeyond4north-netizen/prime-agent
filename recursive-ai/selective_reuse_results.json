  "seen_task_reproduction_python": "import json,tempfile\nfrom pathlib import Path\nfrom research.composition_contract import learn\nfrom research.composition_lifecycle import FIRST,SECOND\nfrom research.composition_validation import coefficients\nfrom research.selective_reuse import solve_batch\nknown=set(FIRST+SECOND)\nfor multipliers, offsets in (((16,32),range(32)),((-32,-16,64),range(-8,8)),((-128,-64,128),range(-12,12)),((-256,256,512),range(-8,8))):\n known.update((a,b) for a in multipliers for b in offsets)\nknown=sorted(known)\nwith tempfile.TemporaryDirectory() as directory:\n state=Path(directory)/'state'\n for training in (FIRST,SECOND):\n  learn(state,[[(x,a*x+b) for x in (-2,0,3)] for a,b in training])\n arms={}\n for mode in ('primitive','selective'):\n  results=[]\n  for offset in range(0,len(known),64):\n   batch=known[offset:offset+64]\n   rows=solve_batch(state,[[(x,a*x+b) for x in (-3,1,4)] for a,b in batch],mode=mode)['results']\n   for target,row in zip(batch,rows):\n    if row['program'] is not None:\n     assert coefficients(row['program'])==target\n   results.extend(rows)\n  arms[mode]=results\n lost=[target for i,target in enumerate(known) if arms['primitive'][i]['program'] is not None and arms['selective'][i]['program'] is None]\n summary={mode:{'solved':sum(r['program'] is not None for r in results),'primitive_evaluations':sum(r['cost'] for r in results)} for mode,results in arms.items()}\n print(json.dumps({'protocol':'post-hoc-seen-task-retention-1','task_count':len(known),'targets':known,'summary':summary,'lost':lost,'limits':['Previously seen tasks, not fresh capability evidence.','Frozen policy unchanged after evaluation.','Separate planner allowance; no equal-wall-deadline guarantee.']},separators=(',',':')))\n"
